<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Raven.Windows.Views.LockedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Raven.Windows.Helpers">

    <!--
        Raven is locked (the Calm locked window): `raven lock` stopped it (privacy.unlock), or Lock v2
        keeps the background program running without its keys (lock.unlock, with the Raven passphrase
        when the profile has one). Nothing of the chats shows behind it: the window shows nothing until
        Raven is unlocked. It fades in; a wrong passphrase shakes the card.
    -->
    <Grid x:Name="LockedRoot" Padding="24" Background="{ThemeResource RavenBackgroundBrush}">
        <Border
            x:Name="Card"
            Width="380"
            Padding="28,26,28,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="{StaticResource RavenDialogRadius}"
            Style="{StaticResource RavenCardStyle}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardShake" />
            </Border.RenderTransform>
            <StackPanel Spacing="10">
                <Image Width="76" Height="76" HorizontalAlignment="Center" Source="ms-appx:///Assets/RavenMark.png" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock HorizontalAlignment="Center" FontSize="20" Style="{StaticResource RavenTitleTextStyle}" Text="{h:Str Key=lock.title}" />
                <TextBlock
                    x:Name="BodyText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource RavenCaptionTextStyle}"
                    Text="{h:Str Key=lock.body}"
                    TextAlignment="Center"
                    Visibility="Collapsed" />
                <PasswordBox
                    x:Name="PassphraseBox"
                    KeyDown="OnPassphraseKeyDown"
                    PlaceholderText="{h:Str Key=lock.passphrase}"
                    Visibility="Collapsed"
                    AutomationProperties.Name="{h:Str Key=lock.passphrase}" />
                <TextBlock
                    x:Name="NoPassphraseText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource RavenMetaTextStyle}"
                    Text="{h:Str Key=lock.noPassphrase}"
                    TextAlignment="Center"
                    TextTrimming="None"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Button
                    x:Name="UnlockButton"
                    HorizontalAlignment="Stretch"
                    Click="OnUnlock"
                    Content="{h:Str Key=lock.unlock}"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="{h:Str Key=lock.unlock}" />
                <TextBlock
                    x:Name="PassphraseNote"
                    HorizontalAlignment="Center"
                    Style="{StaticResource RavenMetaTextStyle}"
                    Text="{h:Str Key=lock.passphrase.note}"
                    TextAlignment="Center"
                    TextTrimming="None"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
