<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Raven.Windows.Views.ErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The engine could not start or the profile cannot be read: what happened, one next step, Details. -->
    <Grid Padding="24" Background="{ThemeResource RavenBackgroundBrush}">
        <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <Image Width="56" Height="56" HorizontalAlignment="Center" Source="ms-appx:///Assets/RavenMark.png" AutomationProperties.AccessibilityView="Raw" />
            <InfoBar x:Name="ErrorBar" IsClosable="False" IsOpen="False" />
        </StackPanel>
    </Grid>
</UserControl>
