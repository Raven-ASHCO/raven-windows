<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Raven theme for WinUI 3, from desktop/design/tokens.json:
      colours per theme (Light.xaml, Dark.xaml; high contrast uses the system colours),
      spacing, radii, layout sizes, type (Segoe UI Variable / Cascadia Mono) and the
      named styles the app applies in code (so theme changes update them too).
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light" Source="ms-appx:///Themes/Light.xaml" />
        <ResourceDictionary x:Key="Dark" Source="ms-appx:///Themes/Dark.xaml" />
        <ResourceDictionary x:Key="Default" Source="ms-appx:///Themes/Dark.xaml" />
        <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="RavenBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenSurfaceMutedBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenBorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                <SolidColorBrush x:Key="RavenAccentFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="RavenOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                <SolidColorBrush x:Key="RavenAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenPresenceInTouchBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="RavenPresenceWaitingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenPresenceNoneBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                <SolidColorBrush x:Key="RavenSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenTextTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                <SolidColorBrush x:Key="RavenAccentFillTopBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="RavenFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="RavenSuccessFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="RavenWarningFillBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenWarningSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenDangerFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="RavenPathLanBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenPathNearbyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenPathTorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenPathDirectBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenPathRelayBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenPathFriendBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenSectionGeneralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenSectionAppearanceBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenSectionPrivacyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenSectionLockBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenSectionNetworkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenSectionUpdatesBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenSectionAboutBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenPathLanSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenPathNearbySoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenPathTorSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenPathDirectSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenPathRelaySoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenPathFriendSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenNeutralSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenSuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenDangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenSidebarPaneBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenWarningLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenFocusRingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenSwitchOffBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                <SolidColorBrush x:Key="RavenKnobBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenIncomingRingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="RavenBubbleOutBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="RavenAvatar0BackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenAvatar0ForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenAvatar1BackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenAvatar1ForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenAvatar2BackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenAvatar2ForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenAvatar3BackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenAvatar3ForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="RavenAvatar4BackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="RavenAvatar4ForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Type: tokens.json "typography" -->
    <FontFamily x:Key="RavenTextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="RavenDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="RavenMonoFontFamily">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="RavenIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <x:Double x:Key="RavenBodyFontSize">14</x:Double>
    <x:Double x:Key="RavenBodyLineHeight">20.3</x:Double>
    <x:Double x:Key="RavenSmallFontSize">11</x:Double>
    <x:Double x:Key="RavenTitleFontSize">17</x:Double>
    <x:Double x:Key="RavenDisplayFontSize">22</x:Double>
    <x:Double x:Key="RavenMonoFontSize">12</x:Double>
    <!-- display tracking 8 px at 22 px = 364/1000 em -->
    <x:Int32 x:Key="RavenDisplayCharacterSpacing">364</x:Int32>
    <!-- Calm type ramp (tokens.json version 2): bubble 14.5 x 1.42, label 13.5, caption 12.5, meta 11.5,
         section label 11 (+0.04 em, upper case in code), brand 15, page title 24 (-0.01 em). -->
    <x:Double x:Key="RavenBubbleFontSize">14.5</x:Double>
    <x:Double x:Key="RavenBubbleLineHeight">20.59</x:Double>
    <x:Double x:Key="RavenLabelFontSize">13.5</x:Double>
    <x:Double x:Key="RavenCaptionFontSize">12.5</x:Double>
    <x:Double x:Key="RavenMetaFontSize">11.5</x:Double>
    <x:Double x:Key="RavenSectionLabelFontSize">11</x:Double>
    <x:Int32 x:Key="RavenSectionLabelCharacterSpacing">40</x:Int32>
    <x:Double x:Key="RavenBrandFontSize">15</x:Double>
    <x:Double x:Key="RavenPageTitleFontSize">24</x:Double>
    <x:Int32 x:Key="RavenPageTitleCharacterSpacing">-10</x:Int32>

    <!-- Spacing: tokens.json "spacing" -->
    <x:Double x:Key="RavenSpaceXs">4</x:Double>
    <x:Double x:Key="RavenSpaceSm">8</x:Double>
    <x:Double x:Key="RavenSpaceMd">12</x:Double>
    <x:Double x:Key="RavenSpaceLg">16</x:Double>
    <x:Double x:Key="RavenSpaceXl">24</x:Double>
    <x:Double x:Key="RavenSpaceXxl">32</x:Double>

    <!-- Radii: tokens.json "radius" -->
    <CornerRadius x:Key="RavenControlRadius">8</CornerRadius>
    <CornerRadius x:Key="RavenCardRadius">16</CornerRadius>
    <CornerRadius x:Key="RavenGroupRadius">14</CornerRadius>
    <CornerRadius x:Key="RavenRowRadius">10</CornerRadius>
    <CornerRadius x:Key="RavenChipRadius">13</CornerRadius>
    <CornerRadius x:Key="RavenChipSmallRadius">10</CornerRadius>
    <CornerRadius x:Key="RavenBadgeRadius">9</CornerRadius>
    <CornerRadius x:Key="RavenComposerRadius">22</CornerRadius>
    <CornerRadius x:Key="RavenSheetRadius">22</CornerRadius>
    <CornerRadius x:Key="RavenDialogRadius">18</CornerRadius>
    <CornerRadius x:Key="RavenSegmentRadius">10</CornerRadius>
    <CornerRadius x:Key="RavenSegmentThumbRadius">7</CornerRadius>
    <CornerRadius x:Key="RavenWindowRadius">12</CornerRadius>
    <!-- bubble 18 with a 6 px tail corner: in = bottom-left, out = bottom-right -->
    <CornerRadius x:Key="RavenBubbleInRadius">18,18,18,6</CornerRadius>
    <CornerRadius x:Key="RavenBubbleOutRadius">18,18,6,18</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

    <!-- Layout: tokens.json "layout" -->
    <x:Double x:Key="RavenSidebarWidth">272</x:Double>
    <x:Double x:Key="RavenSidebarMinWidth">220</x:Double>
    <x:Double x:Key="RavenSettingsNavWidth">228</x:Double>
    <x:Double x:Key="RavenMinWindowWidth">560</x:Double>
    <x:Double x:Key="RavenMinWindowHeight">480</x:Double>
    <x:Double x:Key="RavenHeaderHeight">66</x:Double>
    <x:Double x:Key="RavenRouteLineHeight">34</x:Double>
    <x:Double x:Key="RavenAvatarSize">36</x:Double>
    <x:Double x:Key="RavenAvatarSmall">22</x:Double>
    <x:Double x:Key="RavenAvatarLarge">40</x:Double>
    <x:Double x:Key="RavenPresenceDotSize">11</x:Double>
    <x:Double x:Key="RavenContentMaxWidth">760</x:Double>
    <x:Double x:Key="RavenPageMaxWidth">900</x:Double>
    <x:Double x:Key="RavenSettingsMaxWidth">700</x:Double>
    <x:Double x:Key="RavenBubbleMaxFraction">0.72</x:Double>
    <x:Double x:Key="RavenChipHeight">20</x:Double>
    <x:Double x:Key="RavenPillHeight">26</x:Double>
    <x:Double x:Key="RavenButtonHeight">30</x:Double>
    <x:Double x:Key="RavenSendButtonSize">34</x:Double>
    <x:Double x:Key="RavenSwitchWidth">36</x:Double>
    <x:Double x:Key="RavenSwitchHeight">22</x:Double>
    <x:Double x:Key="RavenSwitchKnobSize">16</x:Double>
    <x:Double x:Key="RavenGroupRingSize">18</x:Double>

    <!-- ===== Text styles ===== -->
    <Style x:Key="RavenBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RavenTextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RavenBodyFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource RavenBodyLineHeight}" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="RavenSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenTextSecondaryBrush}" />
    </Style>
    <Style x:Key="RavenSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenSuccessBrush}" />
    </Style>
    <Style x:Key="RavenWarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenWarningBrush}" />
    </Style>
    <Style x:Key="RavenDangerTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenDangerBrush}" />
    </Style>
    <Style x:Key="RavenSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RavenTextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RavenSmallFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RavenSmallAccentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenSmallTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenAccentBrush}" />
    </Style>
    <Style x:Key="RavenSmallSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenSmallTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenSuccessBrush}" />
    </Style>
    <Style x:Key="RavenSmallWarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenSmallTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenWarningBrush}" />
    </Style>
    <Style x:Key="RavenSmallDangerTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenSmallTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenDangerBrush}" />
    </Style>
    <Style x:Key="RavenTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RavenDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RavenTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="RavenDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RavenDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RavenDisplayFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="{StaticResource RavenDisplayCharacterSpacing}" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextPrimaryBrush}" />
    </Style>
    <Style x:Key="RavenMonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RavenMonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RavenMonoFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>
    <Style x:Key="RavenNameTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RavenTextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RavenBodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style x:Key="RavenBubbleInTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RavenTextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RavenBubbleFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource RavenBubbleLineHeight}" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>
    <Style x:Key="RavenBubbleOutTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenBubbleInTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenOnAccentBrush}" />
    </Style>
    <Style x:Key="RavenChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RavenTextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RavenBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RavenChipHighlightTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenChipTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenAccentBrush}" />
    </Style>
    <Style x:Key="RavenPacketTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource RavenSmallFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextSecondaryBrush}" />
    </Style>
    <Style x:Key="RavenPacketReceiptTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenPacketTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenSuccessBrush}" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style x:Key="RavenCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RavenBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RavenCardRadius}" />
        <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style x:Key="RavenBubbleInStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RavenBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RavenBubbleInRadius}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="RavenBubbleOutStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenBubbleOutBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RavenBubbleOutRadius}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- A message of yours that waits: an outline instead of the fill (DESIGN.md "Calm", pending). -->
    <Style x:Key="RavenBubbleOutWaitingStyle" TargetType="Border" BasedOn="{StaticResource RavenBubbleOutStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource RavenFocusRingBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style x:Key="RavenBubbleOutWaitingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenBubbleInTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenAccentBrush}" />
    </Style>
    <Style x:Key="RavenChipStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource RavenBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RavenChipRadius}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style x:Key="RavenChipHighlightStyle" TargetType="Border" BasedOn="{StaticResource RavenChipStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="RavenChipEmptyStyle" TargetType="Border" BasedOn="{StaticResource RavenChipStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource RavenBorderBrush}" />
    </Style>
    <!-- A small state chip ("stat"): a soft neutral tint, no line. -->
    <Style x:Key="RavenPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenNeutralSoftBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RavenChipSmallRadius}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Avatars and presence ===== -->
    <Style x:Key="RavenAvatarBaseStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource RavenAvatarSize}" />
        <Setter Property="Height" Value="{StaticResource RavenAvatarSize}" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style x:Key="RavenAvatarTextBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RavenAvatar0Style" TargetType="Border" BasedOn="{StaticResource RavenAvatarBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenAvatar0BackgroundBrush}" />
    </Style>
    <Style x:Key="RavenAvatarText0Style" TargetType="TextBlock" BasedOn="{StaticResource RavenAvatarTextBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenAvatar0ForegroundBrush}" />
    </Style>
    <Style x:Key="RavenAvatar1Style" TargetType="Border" BasedOn="{StaticResource RavenAvatarBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenAvatar1BackgroundBrush}" />
    </Style>
    <Style x:Key="RavenAvatarText1Style" TargetType="TextBlock" BasedOn="{StaticResource RavenAvatarTextBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenAvatar1ForegroundBrush}" />
    </Style>
    <Style x:Key="RavenAvatar2Style" TargetType="Border" BasedOn="{StaticResource RavenAvatarBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenAvatar2BackgroundBrush}" />
    </Style>
    <Style x:Key="RavenAvatarText2Style" TargetType="TextBlock" BasedOn="{StaticResource RavenAvatarTextBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenAvatar2ForegroundBrush}" />
    </Style>
    <Style x:Key="RavenAvatar3Style" TargetType="Border" BasedOn="{StaticResource RavenAvatarBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenAvatar3BackgroundBrush}" />
    </Style>
    <Style x:Key="RavenAvatarText3Style" TargetType="TextBlock" BasedOn="{StaticResource RavenAvatarTextBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenAvatar3ForegroundBrush}" />
    </Style>
    <Style x:Key="RavenAvatar4Style" TargetType="Border" BasedOn="{StaticResource RavenAvatarBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenAvatar4BackgroundBrush}" />
    </Style>
    <Style x:Key="RavenAvatarText4Style" TargetType="TextBlock" BasedOn="{StaticResource RavenAvatarTextBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenAvatar4ForegroundBrush}" />
    </Style>
    <Style x:Key="RavenDotBaseStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource RavenPresenceDotSize}" />
        <Setter Property="Height" Value="{StaticResource RavenPresenceDotSize}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{ThemeResource RavenSidebarBrush}" />
    </Style>
    <Style x:Key="RavenDotInTouchStyle" TargetType="Ellipse" BasedOn="{StaticResource RavenDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource RavenPresenceInTouchBrush}" />
    </Style>
    <Style x:Key="RavenDotWaitingStyle" TargetType="Ellipse" BasedOn="{StaticResource RavenDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource RavenPresenceWaitingBrush}" />
    </Style>
    <Style x:Key="RavenDotNoneStyle" TargetType="Ellipse" BasedOn="{StaticResource RavenDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource RavenPresenceNoneBrush}" />
    </Style>
    <Style x:Key="RavenRetryRingStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource RavenPresenceDotSize}" />
        <Setter Property="Height" Value="{StaticResource RavenPresenceDotSize}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke" Value="{ThemeResource RavenPresenceWaitingBrush}" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>

    <!-- ===================================================================================
         Calm (DESIGN.md "Calm", tokens.json version 2). Named styles the app applies in code,
         so a theme change (Settings > Appearance) updates them too.
         =================================================================================== -->

    <!-- Calm text ramp -->
    <Style x:Key="RavenLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RavenTextFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RavenLabelFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style x:Key="RavenLabelWrapTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenLabelTextStyle}">
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="0" />
    </Style>
