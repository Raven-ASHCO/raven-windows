        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="RavenChipOtherIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RavenPillOtherStyle" TargetType="Border" BasedOn="{StaticResource RavenChipOtherStyle}">
        <Setter Property="Height" Value="{StaticResource RavenPillHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource RavenChipRadius}" />
        <Setter Property="Padding" Value="9,0,10,0" />
    </Style>
    <Style x:Key="RavenWayTileOtherStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenNeutralSoftBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="RavenWayTileOtherIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextSecondaryBrush}" />
    </Style>
    <Style x:Key="RavenSectionTileGeneralStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSectionGeneralBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
    </Style>
    <Style x:Key="RavenSectionTileAppearanceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSectionAppearanceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
    </Style>
    <Style x:Key="RavenSectionTilePrivacyStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSectionPrivacyBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
    </Style>
    <Style x:Key="RavenSectionTileLockStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSectionLockBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
    </Style>
    <Style x:Key="RavenSectionTileNetworkStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSectionNetworkBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
    </Style>
    <Style x:Key="RavenSectionTileUpdatesStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSectionUpdatesBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
    </Style>
    <Style x:Key="RavenSectionTileAboutStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSectionAboutBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
    </Style>

    <!-- Avatars: small (22) and large (40) sizes over the colour styles above -->
    <Style x:Key="RavenAvatarSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The Calm switch (Controls/CalmSwitch.cs): a 36 x 22 track, a knob that springs across. -->
    <Style x:Key="RavenSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource RavenSwitchWidth}" />
        <Setter Property="Height" Value="{StaticResource RavenSwitchHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Background="{ThemeResource RavenSwitchOffBrush}" CornerRadius="11" />
                        <Border x:Name="OnTrack" Background="{ThemeResource RavenSuccessFillBrush}" CornerRadius="11" Opacity="0" />
                        <Ellipse
                            x:Name="Knob"
                            Width="{StaticResource RavenSwitchKnobSize}"
                            Height="{StaticResource RavenSwitchKnobSize}"
                            Margin="3,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource RavenKnobBrush}"
                            Stroke="{ThemeResource RavenBorderBrush}"
                            StrokeThickness="0.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A radio button drawn only by its content: segmented controls and the Settings sections. -->
    <Style x:Key="RavenPlainRadioStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <ContentPresenter
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Background="{TemplateBinding Background}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The group ring: one arc per member a message of yours was for (GroupPresenter.Segments). -->
    <Style x:Key="RavenRingDeliveredStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource RavenSuccessFillBrush}" />
        <Setter Property="StrokeThickness" Value="3.2" />
    </Style>
    <Style x:Key="RavenRingPassedOnStyle" TargetType="Path" BasedOn="{StaticResource RavenRingDeliveredStyle}">
        <Setter Property="Stroke" Value="{ThemeResource RavenWarningFillBrush}" />
    </Style>
    <Style x:Key="RavenRingPendingStyle" TargetType="Path" BasedOn="{StaticResource RavenRingDeliveredStyle}">
        <Setter Property="Stroke" Value="{ThemeResource RavenBorderStrongBrush}" />
    </Style>
    <Style x:Key="RavenRingFailedStyle" TargetType="Path" BasedOn="{StaticResource RavenRingDeliveredStyle}">
        <Setter Property="Stroke" Value="{ThemeResource RavenDangerFillBrush}" />
    </Style>
    <!-- The Tor onion (no Segoe glyph for it): two ellipses in the Tor colour. -->
    <Style x:Key="RavenOnionStyle" TargetType="Ellipse">
        <Setter Property="Stroke" Value="{ThemeResource RavenPathTorBrush}" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style x:Key="RavenAvatarYouStyle" TargetType="Border" BasedOn="{StaticResource RavenAvatarBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenAccentSoftBrush}" />
    </Style>
    <Style x:Key="RavenAvatarTextYouStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenAvatarTextBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenAccentBrush}" />
    </Style>
    <Style x:Key="RavenAvatarRingStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource RavenSidebarBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- An incoming bubble just arrived: a soft accent ring for 1.5 s (Calm "fresh"). -->
    <Style x:Key="RavenBubbleInFreshStyle" TargetType="Border" BasedOn="{StaticResource RavenBubbleInStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource RavenIncomingRingBrush}" />
    </Style>
    <!-- Bars and surfaces the code-built pages use (so a theme change follows). -->
    <Style x:Key="RavenHeaderBarStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource RavenBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="{StaticResource RavenHeaderHeight}" />
        <Setter Property="Padding" Value="22,10,22,10" />
    </Style>
    <Style x:Key="RavenRouteBarStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource RavenBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="{StaticResource RavenRouteLineHeight}" />
        <Setter Property="Padding" Value="22,0,22,0" />
    </Style>
    <Style x:Key="RavenRouteLabelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenBackgroundBrush}" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RavenPageStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenBackgroundBrush}" />
    </Style>
    <Style x:Key="RavenTertiaryIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Security words: Calm tiles; the one being said is filled with the accent and raised. -->
    <Style x:Key="RavenWordTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RavenBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,9,10,9" />
        <Setter Property="Margin" Value="4" />
    </Style>
    <Style x:Key="RavenWordTileCheckStyle" TargetType="Border" BasedOn="{StaticResource RavenWordTileStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource RavenPathFriendBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style x:Key="RavenWordTileSayStyle" TargetType="Border" BasedOn="{StaticResource RavenWordTileStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenAccentFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RavenAccentFillBrush}" />
    </Style>
    <Style x:Key="RavenWordNumberTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextTertiaryBrush}" />
    </Style>
    <Style x:Key="RavenWordTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource RavenTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RavenWordSayNumberTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenWordNumberTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenOnAccentBrush}" />
    </Style>
    <Style x:Key="RavenWordSayTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenWordTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenOnAccentBrush}" />
    </Style>
    <Style x:Key="RavenWordCheckTagTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="50" />
        <Setter Property="Foreground" Value="{ThemeResource RavenPathFriendBrush}" />
    </Style>
    <Style x:Key="RavenWordCheckTagSayTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenWordCheckTagTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenOnAccentBrush}" />
    </Style>
    <!-- The lock (Controls/LockGlyph.cs): a body and a shackle that closes before Raven locks. -->
    <Style x:Key="RavenLockTileAccentStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="RavenLockPartAccentStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource RavenAccentBrush}" />
    </Style>
    <Style x:Key="RavenLockDotAccentStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource RavenAccentBrush}" />
    </Style>
    <Style x:Key="RavenLockTileSuccessStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSuccessSoftBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="RavenLockPartSuccessStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource RavenSuccessBrush}" />
    </Style>
    <Style x:Key="RavenLockDotSuccessStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource RavenSuccessBrush}" />
    </Style>
    <Style x:Key="RavenLockTileDangerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenDangerSoftBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="RavenLockPartDangerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource RavenDangerBrush}" />
    </Style>
    <Style x:Key="RavenLockDotDangerStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource RavenDangerBrush}" />
    </Style>
    <Style x:Key="RavenDangerButtonTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource RavenDangerBrush}" />
    </Style>
    <!-- Settings: the fine line between items, and the state chips ("stat"). -->
    <Style x:Key="RavenSeparatorStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenBorderBrush}" />
    </Style>
    <Style x:Key="RavenStatSuccessStyle" TargetType="Border" BasedOn="{StaticResource RavenPillStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenSuccessSoftBrush}" />
    </Style>
    <Style x:Key="RavenStatWarningStyle" TargetType="Border" BasedOn="{StaticResource RavenPillStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenWarningSoftBrush}" />
    </Style>
    <!-- Setup's steps (Controls/StepsBar.cs): done (green check), now (accent number), later. -->
    <Style x:Key="RavenStepDoneStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RavenSuccessFillBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>
    <Style x:Key="RavenStepNowStyle" TargetType="Border" BasedOn="{StaticResource RavenStepDoneStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenAccentFillBrush}" />
    </Style>
    <Style x:Key="RavenStepLaterStyle" TargetType="Border" BasedOn="{StaticResource RavenStepDoneStyle}">
        <Setter Property="Background" Value="{ThemeResource RavenNeutralSoftBrush}" />
    </Style>
    <Style x:Key="RavenStepOnTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource RavenOnAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RavenStepTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RavenStepOnTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RavenTextSecondaryBrush}" />
    </Style>
    <Style x:Key="RavenStepBarStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="2" />
        <Setter Property="Fill" Value="{ThemeResource RavenBorderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RavenStepBarDoneStyle" TargetType="Rectangle" BasedOn="{StaticResource RavenStepBarStyle}">
        <Setter Property="Fill" Value="{ThemeResource RavenSuccessFillBrush}" />
    </Style>

</ResourceDictionary>
